{
  "name": "heima-ledger",
  "version": "1.0.0",
  "description": "黑马记账 - 个人记账桌面应用",
  "main": "./electron/main.cjs",
  "scripts": {
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite",
    "dev": "env -u ELECTRON_RUN_AS_NODE concurrently \"npm run dev:server\" \"npm run dev:client\" \"electron .\"",
    "build": "vite build",
    "package:mac": "vite build && electron-builder --mac",
    "package:win": "vite build && electron-builder --win",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
